# Your carriers' test keys: copy to .env (git-ignored), fill in what you have.
# A carrier is configured once every key its README calls for is set; the
# others stay listed as "not configured" by `docker compose run --rm omnibus gateways`.
# Sandboxes are on; <CARRIER>_SANDBOX=0 goes live.

# Where the carriers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIBUS_PLUGINS=../..

# The addresses the console ships between (overridable per command with --from-* / --to-*).
HARNESS_SENDER_NAME="Glitch Art"
HARNESS_SENDER_COMPANY=
HARNESS_SENDER_STREET="12 rue de la Paix"
HARNESS_SENDER_POSTCODE=75002
HARNESS_SENDER_CITY=Paris
HARNESS_SENDER_COUNTRY=FR
HARNESS_SENDER_EMAIL=shop@example.org
HARNESS_SENDER_PHONE=+33102030405
HARNESS_RECIPIENT_NAME="Émile Zola"
HARNESS_RECIPIENT_STREET="21 bis rue de Bruxelles"
HARNESS_RECIPIENT_POSTCODE=75009
HARNESS_RECIPIENT_CITY=Paris
HARNESS_RECIPIENT_COUNTRY=FR
HARNESS_RECIPIENT_EMAIL=emile@example.org
HARNESS_RECIPIENT_PHONE=0612345678

# Mondial Relay (defaults to the public test brand BDTEST13 / PrivateK)
MONDIAL_RELAY_ENSEIGNE=
MONDIAL_RELAY_PRIVATE_KEY=
# Chronopost (no sandbox; the published test account is 19869502 / 255562)
CHRONOPOST_ACCOUNT=
CHRONOPOST_PASSWORD=
CHRONOPOST_SUB_ACCOUNT=
# UPS (developer.ups.com app + shipper account)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT=
UPS_SANDBOX=1
# FedEx (developer.fedex.com project)
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT=
FEDEX_SANDBOX=1
# DHL Express (MyDHL API app; Location Finder key for service points)
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT=
DHL_LOCATION_KEY=
DHL_SANDBOX=1
# TNT ExpressConnect (existing accounts only)
TNT_USERNAME=
TNT_PASSWORD=
TNT_ACCOUNT=
# GLS ShipIT
GLS_USERNAME=
GLS_PASSWORD=
GLS_CONTACT_ID=
GLS_SANDBOX=1
# DB Schenker Open API (tracking needs nothing)
SCHENKER_API_KEY=
SCHENKER_ACCOUNT=
# USPS APIs v3 (labels need the payer: CRID, MID, EPS account)
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_CRID=
USPS_MID=
USPS_EPS_ACCOUNT=
USPS_SANDBOX=1
# Royal Mail Click & Drop (+ Tracking API)
ROYAL_MAIL_API_KEY=
RM_TRACKING_ID=
RM_TRACKING_SECRET=
# Canada Post Developer Program
CANADA_POST_USERNAME=
CANADA_POST_PASSWORD=
CANADA_POST_CUSTOMER=
CANADA_POST_CONTRACT=
CANADA_POST_SANDBOX=1
# Purolator E-Ship
PUROLATOR_KEY=
PUROLATOR_PASSWORD=
PUROLATOR_ACCOUNT=
PUROLATOR_SANDBOX=1
# Canpar CanShip
CANPAR_USER=
CANPAR_PASSWORD=
CANPAR_SHIPPER=
