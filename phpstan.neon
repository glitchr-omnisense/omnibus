# PHPStan at the highest level, as the family's harness runs it (docker compose run --rm omnibus
# phpstan, in omnisense/omnibus's docker/). phpstan-baseline.neon holds what was there when
# PHPStan came in (2026-11-10): it may only shrink.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
    # The bundle names every carrier's factory (Bridge/Symfony/OmnibusBundle::FACTORIES) and registers
    # those installed. Installed alone (this package's CI), they are unknown classes; with every
    # carrier (the family's harness), PHPStan knows each is a GatewayFactoryInterface. Both hold.
    ignoreErrors:
        -
            identifier: class.notFound
            path: Bridge/Symfony/OmnibusBundle.php
            reportUnmatched: false
        -
            identifier: function.alreadyNarrowedType
            path: Bridge/Symfony/OmnibusBundle.php
            reportUnmatched: false
